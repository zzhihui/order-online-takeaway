<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:local="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:layout_width="fill_parent"
    android:layout_height="fill_parent"
    android:layout_marginLeft="5dp"
    android:layout_marginRight="5dp">
  <!--Header-->
  <include layout="@layout/_headmessagecontrol"/>

  <!--IndaSoft Image-->
  <RelativeLayout
    android:layout_width="fill_parent"
    android:layout_height="wrap_content">

    <MvxImageView
      android:src="@drawable/IndaSoftIcon"
     android:layout_width="150dp"
     android:layout_height="150dp"
      android:layout_centerHorizontal="true"/>

  </RelativeLayout>

  <!--Space taker-->
  <LinearLayout
         android:layout_width="fill_parent"
         android:layout_height="wrap_content"
         android:layout_weight="1"
         android:orientation="horizontal"/>

  <!--Contact us-->
  <Button
        android:text="@string/app_page_about_contactindasoft"
        android:layout_marginBottom="10dp"
        android:layout_width="fill_parent"
        android:layout_height="wrap_content"
        style="@style/AppFont.Medium"
        local:MvxBind="Click ContactIndaSoftCommand" />

  <!--Build Number-->
  <TextView
        style="@style/AppFont.Medium"
        android:text="@string/app_versionname"
        android:layout_width="fill_parent"
        android:layout_height="wrap_content"/>


  <!--CopyRights-->
  <TextView
        style="@style/AppFont.Medium"
        android:text="@string/app_page_about_copyright"
        android:layout_marginBottom="100dp"
        android:layout_width="fill_parent"
        android:layout_height="wrap_content"/>

</LinearLayout>

