<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:local="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:layout_width="fill_parent"
    android:layout_height="fill_parent">
  <!--Header-->
  <include layout="@layout/_headmessagecontrol"/>

  <!--Category header-->
  <LinearLayout
      android:layout_width="fill_parent"
      android:layout_height="wrap_content"
      android:orientation="vertical">
    <TextView
        style="@style/AppFont.Medium.Bold"
        android:layout_width="match_parent"
        android:layout_marginLeft="10dp"
        local:MvxBind="Text MenuItemCategory.Name"
        android:layout_height="wrap_content" />
    <TextView
        style="@style/AppFont.Small"
        android:layout_width="match_parent"
        android:layout_marginLeft="10dp"
        local:MvxBind="Text MenuItemCategory.Description"
        android:layout_height="wrap_content" />
  </LinearLayout>

  <!--Line break-->
  <LinearLayout
      android:layout_width="fill_parent"
      android:layout_height="1dp"
      android:background="#000000"
      android:orientation="horizontal" />

  <!--Listview-->
  <LinearLayout
      android:layout_width="fill_parent"
      android:layout_height="wrap_content"
      android:layout_marginTop="10dp"
      android:layout_weight="1"
      android:orientation="vertical">
    <Mvx.MvxListView
        android:layout_width="fill_parent"
        android:layout_height="fill_parent"
        android:choiceMode="singleChoice"
        local:MvxBind="ItemsSource CategoryItems; ItemClick CategoryItemsSelectedCommand"
        local:MvxItemTemplate="@layout/categoryitemslistview" />
  </LinearLayout>
</LinearLayout>