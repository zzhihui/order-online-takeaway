@using System.Configuration
@using Core.Common.Utility.Extension
@using Takeaway.Service.Extension
@using Takeway.Web.Application.Extension
@using Takeway.Web.Content
@model Takeway.Web.ViewModels.Order.BasketViewModel
@{
    ViewBag.Title = WebResource.page_order_basket_title;

    Layout = Html.Shared("_Layout.cshtml");
    var disabled = "";
    if (!Model.AllowSubmit)
    {
        disabled = "disabled";
    }
}

<h2>@WebResource.page_order_basket_title</h2>

<div class="well">

    <form id="submitform" class="form-horizontal" method="post">
        <fieldset>
            <legend>@WebResource.page_order_basket_ordersummary</legend>
            <div class="list-group-item">
                @Html.ActionLink("Back to Menu", "Category", "Order", null, new { @class = "btn btn-primary" })
            </div>
            <p class="text-danger">@Html.ValidationSummary(true)</p>
            @Html.AntiForgeryToken()
            @Html.HiddenFor(r => r.MinOrder)
            @Html.HiddenFor(r => r.ShopInfo.IsOpen)
            @*Min Order*@
            @if (Model.MinOrder > 0)
            {
                <div class="list-group">
                    <div class="list-group-item">
                        <div class="form-group ">

                            <label class="col-lg-2 control-label"><h5 class="text-danger">@WebResource.page_order_basket_minorder</h5></label>
                            <div class="col-lg-10">
                                <label class="col-lg-2 control-label"><h5 class="text-danger">@Model.MinOrder.ToPriceStringIe()</h5></label>
                            </div>
                        </div>

                    </div>
                </div>
            }
            @if (Model.ShopInfo.IsOpen.HasValue && !Model.ShopInfo.IsOpen.Value)
            {
                <div class="list-group">
                    <div class="list-group-item">
                        <h4 class="list-group-item-heading text-danger">@WebResource.page_order_basket_closed</h4>
                        <p class="list-group-item-text"></p>
                    </div>

                </div>
            }@*Menu Items*@
            <div class="list-group">
                <div class="list-group-item">
                    <h4 class="list-group-item-heading">@WebResource.page_order_basket_orderitemheader</h4>
                    <p class="list-group-item-text"></p>
                </div>
                <div class="list-group-item">
                    @Html.ActionLink("Add more food", "Category", "Order", null, new { @class = "btn btn-primary" })
                </div>

                @foreach (var orderItem in Model.MyOrder.OrderItems)
                {
                    <a href="@Url.Action("removeitemfrombasket", "order", new {id=orderItem.Guid})" class="list-group-item">
                        <div class="form-group">

                            <label class="col-lg-2 control-label">@orderItem.Name</label>
                            <div class="col-lg-10">
                                <label class="form-control-static">@orderItem.Price.ToPriceStringIe()</label>
                                <span class="badge">@WebResource.page_order_basket_removefrombasket</span>
                                <span class="help-block">@orderItem.SubItemWithComment()</span>
                                <span class="help-block">@orderItem.Comment</span>
                            </div>
                        </div>
                    </a>
                }

                <div class="list-group-item">
                    <div class="form-group">
                        <h5><label class="col-lg-2 control-label">@WebResource.page_order_basket_subtotal</label></h5>
                        <div class="col-lg-10">
                            <h5><label class="form-control-static">@Model.MyOrder.OrderTotal.ToPriceStringIe()</label></h5>

                            <span class="help-block"><a href="@Url.Action("deliveryarea", "order")">@WebResource.page_order_basket_deliveryarea</a></span>
                            @if (Model.MyOrder.OrderOriginalTotal > Model.MyOrder.OrderTotal)
                            {
                                <p class="text-danger">Note: Discount may be applied</p>
                            }

                        </div>
                    </div>
                </div>

                <div class="list-group-item">
                    <div class="form-group">
                        <label class="col-lg-2 control-label">Delivery Charge</label>
                        <div class="col-lg-10">
                            <label class="form-control-static">Start from @Model.ShopInfo.DeliveryCharge.ToPriceStringIe()</label>
                        </div>
                    </div>
                </div>

            </div>

            @*Delivery Options*@
            <div class="list-group">
                <div class="list-group-item">
                    <h4 class="list-group-item-heading">@WebResource.page_order_basket_deliveryoption</h4>
                    <div class="form-group">

                        <label class="col-lg-2 control-label"> &nbsp;</label>
                        <div class="col-lg-10">
                            @Html.DropDownListFor(r => r.SelectedDeliveryOptionId, new SelectList(@Model.DeliveryOptions, "Id", "Name"), new { @class = "form-control" })
                        </div>
                    </div>

                </div>
            </div>


            @*Contact Info*@
            <div class="list-group">
                <div class="list-group-item">
                    <h4 class="list-group-item-heading">@WebResource.page_order_basket_contactinfo</h4>
                    <p class="list-group-item-text">@WebResource.page_order_basket_contactinfocomment</p>

                    <div class="form-group">

                        <label class="col-lg-2 control-label">@WebResource.page_order_basket_contactname</label>
                        <div class="col-lg-10 has-error">
                            @Html.TextBoxFor(t => t.Name, new { @class = "form-control", @placeholder = WebResource.page_order_basket_contactname })
                            @Html.ValidationMessageFor(x => x.Name)
                        </div>
                    </div>

                    <div class="form-group">

                        <label class="col-lg-2 control-label">@WebResource.page_order_basket_phone</label>
                        <div class="col-lg-10 has-error">
                            @Html.TextBoxFor(t => t.PhoneNumber, new { @class = "form-control", @placeholder = WebResource.page_order_basket_phone })
                            @Html.ValidationMessageFor(x => x.PhoneNumber)
                        </div>
                    </div>

                    <div class="form-group">

                        <label class="col-lg-2 control-label">@WebResource.page_order_basket_email</label>
                        <div class="col-lg-10 has-error">
                            @Html.TextBoxFor(t => t.Email, new { @class = "form-control", @placeholder = WebResource.page_order_basket_email })
                            @Html.ValidationMessageFor(x => x.Email)
                        </div>
                    </div>

                    <div class="form-group">

                        <label class="col-lg-2 control-label">@WebResource.page_order_basket_address</label>
                        <div class="col-lg-10 has-error">
                            @Html.TextAreaFor(t => t.Address, new { @class = "form-control", @placeholder = WebResource.page_order_basket_address })
                            @Html.ValidationMessageFor(x => x.Address)
                        </div>
                    </div>

                    @if (ConfigurationManager.AppSettings["SingleDeliveryCharge"] != "true")
                    {
                        <div class="form-group">

                            <label class="col-lg-2 control-label">Select Your Area</label>
                            <div class="col-lg-10 has-error">
                                @Html.DropDownListFor(r => r.SelectedDeliveryAreaId, new SelectList(@Model.DeliveryAreas, "Id", "Area"), new { @class = "form-control" })
                            </div>
                        </div>
                    }

                </div>
            </div>

            @*Final Comment*@
            <div class="list-group">
                <div class="list-group-item">
                    <h4 class="list-group-item-heading">@WebResource.page_order_basket_finalcomment</h4>
                    <div class="form-group">

                        <label class="col-lg-2 control-label">@WebResource.page_order_basket_commentlabel</label>
                        <div class="col-lg-10">
                            @Html.TextAreaFor(t => t.Comment, new { @class = "form-control", @placeholder = WebResource.page_order_basket_commentlabel })
                        </div>
                    </div>

                </div>
            </div>

            <div class="form-group">
                <div class="col-lg-10 col-lg-offset-2">
                    <button type="submit" class="btn btn-primary" @disabled>@WebResource.page_order_basket_submitorderbutton</button>
                </div>
            </div>

        </fieldset>
    </form>

</div>


<script src="~/Scripts/jquery-1.10.2.min.js"></script>
<script type="text/javascript">
    $("#submitform").submit(function (event) {
        $("#spinner").show().delay(3000).fadeOut();;

    });

</script>