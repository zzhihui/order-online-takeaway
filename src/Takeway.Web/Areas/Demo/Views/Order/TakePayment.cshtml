@using Core.Common.Utility.Extension
@using Takeway.Web.Application.Extension
@model Takeway.Web.ViewModels.Order.PaymentViewModel
@{
    ViewBag.Title = "TakePayment";
    Layout = Html.Shared("_Layout.cshtml");
}

<h2>Take Payment</h2>

<div class="well">
    <form id="submitform" class="form-horizontal" method="post">
        <fieldset>
            <legend>Please enter payment detail</legend>
            <div class="list-group-item">
                @Html.ActionLink("Back to Menu", "Category", "Order", null, new { @class = "btn btn-primary" })
            </div>
            <p class="text-danger">@Html.ValidationSummary(true)</p>
            @Html.AntiForgeryToken()
            @*Payment Amount*@
            <div class="list-group">
                <div class="list-group-item">
                    <div class="form-group">
                        <label class="col-lg-2 control-label">Order Total</label>
                        <div class="col-lg-10">
                            <label class="col-lg-2 control-label">@Model.OrderTotal.ToPriceStringIe()</label>
                        </div>
                    </div>
                </div>
                <div class="list-group-item">
                    <div class="form-group">
                        <label class="col-lg-2 control-label">Delivery Charge</label>
                        <div class="col-lg-10">
                            <label class="col-lg-2 control-label">@Model.DeliveryCharge.ToPriceStringIe()</label>
                        </div>
                    </div>
                </div>
                <div class="list-group-item">
                    <div class="form-group">
                        <label class="col-lg-2 control-label">Amount</label>
                        <div class="col-lg-10 has-error">
                            <label class="col-lg-2 control-label">@Model.Payment.Amount.ToPriceStringIe()</label>
                            @Html.HiddenFor(r => r.Payment.Amount)
                        </div>
                    </div>

                </div>
            </div>
            @*Payment Holder*@
            <div class="list-group-item">
                <div class="form-group">
                    <label class="col-lg-2 control-label">Cardholder</label>
                    <div class="col-lg-10">
                        @Html.TextBoxFor(t => t.Payment.CardName, new { @class = "form-control", @placeholder = "Cardholder name", })
                        @Html.ValidationMessageFor(x => x.Payment.CardName)
                    </div>
                </div>

            </div>


            @*Payment CardNumber*@
            <div class="list-group-item">
                <div class="form-group">
                    <label class="col-lg-2 control-label">Cardnumber</label>
                    <div class="col-lg-10 has-error">
                        @Html.TextBoxFor(t => t.Payment.CardNumber, new { @class = "form-control", @placeholder = "Card number ", autocomplete = "off" })
                        @Html.ValidationMessageFor(x => x.Payment.CardNumber)
                        <img src="\content\card-logos.png" />
                    </div>
                </div>

            </div>

            @*CVC Code*@
            <div class="list-group-item">
                <div class="form-group">
                    <label class="col-lg-2 control-label">CVC</label>
                    <div class="col-lg-10 has-error">
                        @Html.TextBoxFor(t => t.Payment.CardCvc, new {@class = "form-control", @placeholder = "CVC Code", autocomplete = "off"})
                        @Html.ValidationMessageFor(x => x.Payment.CardCvc)
                        <img src="\content\security-card.png"/>
                    </div>
                </div>

            </div>
            
            @*Expire Date*@

            <div class="list-group-item">
                <h4 class="list-group-item-heading">Expire Date</h4>
                <div class="form-group">
                    <label class="col-lg-2 control-label">Expire Month</label>
                    <div class="col-lg-10">
                        @Html.DropDownListFor(r => r.SelectedMonth, new SelectList(@Model.PaymentMonths, "Id", "Name"), new {@class = "form-control"})
                    </div>
                </div>
                <div class="form-group">
                    <label class="col-lg-2 control-label">Expire Year</label>
                    <div class="col-lg-10">
                        @Html.DropDownListFor(r => r.SelectedYear, new SelectList(@Model.PaymentYears, "Id", "Name"), new {@class = "form-control"})
                    </div>
                </div>
            </div>
            <div class="list-group-item">
                <div class="form-group">
                    <label class="col-lg-2 control-label">&nbsp;</label>
                    <div class="col-lg-10 has-error">
                        <img src="\content\encryption.png" />
                    </div>
                </div>

            </div>

            <div class="form-group">
                <div class="col-md-3 col-xs-5">
                    <input type="submit" name="action:PayLater" value="Pay Later" class="btn btn-primary" />
                </div>
                <div class="col-md-8 col-xs-5 col-xs-offset-2 col-md-offset-0">
                    <input type="submit" name="action:TakePayment" value="Take Payment" class="btn btn-primary" />
                </div>
            </div>
        </fieldset>
    </form>

</div>

<script src="~/Scripts/jquery-1.10.2.min.js"></script>
<script type="text/javascript">
    $("#submitform").submit(function (event) {
        $("#spinner").show().delay(3000).fadeOut();;

    });

</script>