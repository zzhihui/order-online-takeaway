@using Core.Common.Utility.Extension
@using Takeway.Web.Application.Extension
@model Takeway.Web.Models.Admin.KillOrderViewModel
@{
    ViewBag.Title = "Report Orders";
    Layout = Html.Shared("_LayoutAdmin.cshtml");
   
}

<script type="text/javascript">
    $(function () { // will trigger when the document is ready
        $('.datepicker').datepicker(); //Initialise any date pickers
    });
</script>

<div class="well">
    <form class="form-horizontal" method="post">
        <fieldset>
            <legend>Report Orders</legend>
            @Html.AntiForgeryToken()
            @*Summary Date*@
            <div class="list-group">
                <div class="list-group-item">
                    <div class="form-group">
                        <label class="col-lg-2 control-label">Order Date</label>
                        <div class="col-lg-10 has-error">
                            @Html.EditorFor(m => m.FromDate)
                            @Html.ValidationMessageFor(r => r.FromDate)
                        </div>
                    </div>

                </div>
            </div>
            <div class="form-group">
                <div class="col-lg-10 col-lg-offset-2">
                    <button type="submit" class="btn btn-primary">Get Orders</button>
                </div>
            </div>
            <div class="list-group">

                <table class="table table-striped table-hover">
                    <thead>
                        <tr>
                            <th>Name:</th>
                            <th>Phone:</th>
                            <th>Address:</th>
                            <th>Delivery Type:</th>
                            <th>Internal Order:</th>
                            <th>Order Total:</th>
                            <th>Payment Ref:</th>
                            <th>Order Time:</th>
                            <th>Payment Type:</th>
                            <th>&nbsp;</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var order in Model.Orders)
                        {

                            <tr>
                                <td>@order.ContactName</td>
                                <td>@order.PhoneNumber</td>
                                <td>@order.Address</td>
                                <td>@order.DeliveryType.Name</td>
                                <td>@order.IsInternalOrder</td>
                                <td>@order.OrderTotal.ToPriceStringIe()</td>
                                <td>@order.PaymentRef</td>
                                <td>@order.Created.ToDateUtcFormat()</td>
                                <td>@order.PaymentType</td>
                                <td><a href="@Url.Action("RemoveOrderById", "Admin", new {orderId=order.Id})">Remove order</a> </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

        </fieldset>
    </form>

</div>
