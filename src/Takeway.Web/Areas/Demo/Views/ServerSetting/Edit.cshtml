@using Takeway.Web.Application.Extension
@model Takeway.Web.ViewModels.Admin.ServerSettingViewModel

@{
    ViewBag.Title = "Edit Setting";
    Layout = Html.Shared("_LayoutAdmin.cshtml");
}

<div class="well">
    <form class="form-horizontal" method="post">
        <fieldset>
            <legend>Edit</legend>
            <div class="text-danger">@Model.ErrorMessage</div>
            @Html.AntiForgeryToken()
            <div class="form-horizontal">
                @Html.ValidationSummary(true, "", new { @class = "text-danger" })

                <div class="form-group">
                    @Html.ActionLink("Back", "List", "ServerSetting", null, new { @class = "btn btn-primary" })
                </div>

                <div class="form-group">
                    @Html.HiddenFor(model => model.SelectedSetting.Id)
                    <label class="col-lg-2 control-label">Name</label>
                    <div class="col-md-10">
                        @Html.DisplayFor(model => model.SelectedSetting.Name, new { htmlAttributes = new { @class = "form-control" } })
                    </div>
                </div>

                <div class="form-group">
                    <label class="col-lg-2 control-label">Value</label>
                    <div class="col-md-10">
                        @Html.EditorFor(model => model.SelectedSetting.SettingValue, new { htmlAttributes = new { @class = "form-control" } })
                    </div>
                </div>

                <div class="form-group">
                    <div class="col-md-offset-2 col-md-10">
                        <input type="submit" value="Update" class="btn btn-primary" />
                    </div>
                </div>
            </div>

        </fieldset>
    </form>

</div>