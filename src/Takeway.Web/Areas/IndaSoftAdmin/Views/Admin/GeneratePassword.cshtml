@model Takeway.Web.ViewModels.Admin.GeneratePasswordViewModel
@using Takeway.Web.Application.Extension

@{
    ViewBag.Title = "Report";
    Layout = Html.Shared("_LayoutAdmin.cshtml");

}

<div class="page-wrapper">
    <form class="form-horizontal" method="post">
        <fieldset>
            <legend>Report</legend>
            @Html.AntiForgeryToken()
            @*Summary Date*@
            <div class="list-group">
                <div class="list-group-item">
                    <div class="form-group">
                        <label class="col-lg-2 control-label">Enter Password</label>
                        <div class="col-lg-10 has-error">
                            @Html.EditorFor(m => m.Password)
                            @Html.ValidationMessageFor(r => r.Password)
                        </div>
                    </div>

                </div>
                <div class="list-group-item">
                    <div class="form-group">
                        <label class="col-lg-2 control-label">&nbsp;</label>
                        <div class="col-lg-10">
                            @Model.PasswordString
                        </div>
                    </div>

                </div>
            </div>
            <div class="form-group">
                <div class="col-lg-10 col-lg-offset-2">
                    <input type="submit" class="btn btn-primary" />
                </div>
            </div>
            

        </fieldset>
    </form>

</div>