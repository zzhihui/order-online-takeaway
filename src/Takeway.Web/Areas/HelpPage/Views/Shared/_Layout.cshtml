@using System.Reflection
@using Takeway.Web.Controllers
<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <title>@ViewBag.Title</title>
    @RenderSection("scripts", required: false)
</head>
<body>
    @RenderBody()
    <hr />
    <footer>
        <p>&copy; @DateTime.Now.Year - IndaSoft Ltd   Ver:@Assembly.GetAssembly(typeof(HomeController)).GetName().Version.ToString()</p>
    </footer>
</body>
</html>