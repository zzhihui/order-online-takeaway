@using Core.Common.Utility.Extension
@using Takeway.Web.Application.Extension
@model Takeway.Web.ViewModels.Order.DeliveryAreaViewModel
@{
    ViewBag.Title = "DeliveryArea";
    Layout = Html.Shared("_Layout.cshtml");
}


<section id="app">
    <div class="container">

        <div class="row">
            <div class="col-sm-12 titlebar">
                <h2>Delivery Area</h2>
            </div>
        </div>
        <div class="row">
            <table class="table table-striped table-hover">
                <thead>
                    <tr>
                        <th>Area:</th>
                        <th>Min Order:</th>
                        <th>Delivery Cost:</th>
                    </tr>
                </thead>
                <tbody>

                    @foreach (var entry in Model.DeliveryAreas)
                    {
                    <tr>
                        <td>@entry.Area</td>
                        <td>
                            @if (entry.MinOrder == null)
                            {
                            @Html.Raw("No minimum")
                            }
                            else
                            {
                            @Html.Raw(entry.MinOrder.ToPriceStringIe())
                            }
                        </td>
                        <td>
                            @if (entry.DeliveryCost == null)
                            {
                            @Html.Raw("Free")
                            }
                            else
                            {
                            @Html.Raw(entry.DeliveryCost.ToPriceStringIe())
                            }
                        </td>
                    </tr>

                    }
                </tbody>
            </table>
        </div>


    </div>
</section>