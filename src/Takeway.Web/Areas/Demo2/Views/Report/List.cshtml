@using Takeway.Web.Application.Extension
@{
    ViewBag.Title = "List";

    Layout = Html.Shared("_LayoutAdmin.cshtml");
}
<div id="page-wrapper">
    <h2>Reports</h2>
    <div class="well">

        <div class="list-group">
            <a href="@Url.Action("DailyReport", "Report" , new {id=1})" class="list-group-item">
                <h4 class="list-group-item-heading">Summary Report 单日总数</h4>
                <p class="list-group-item-text">&nbsp;</p>
            </a>
            <a href="@Url.Action("MultipleReport", "Report" , new {id=7})" class="list-group-item">
                <h4 class="list-group-item-heading">Summary Report 多日总数</h4>
                <p class="list-group-item-text">&nbsp;</p>
            </a>

            <a href="@Url.Action("DailyReport", "Report" , new {id=2})" class="list-group-item">
                <h4 class="list-group-item-heading">Detail Transaction Report 单日详细</h4>
                <p class="list-group-item-text">&nbsp;</p>
            </a>
            <a href="@Url.Action("MultipleReport", "Report" , new {id=8})" class="list-group-item">
                <h4 class="list-group-item-heading">Detail Transaction Report 多日详细</h4>
                <p class="list-group-item-text">&nbsp;</p>
            </a>

            <a href="@Url.Action("DailyReport", "Report" , new {id=4})" class="list-group-item">
                <h4 class="list-group-item-heading">Detail Order Report 单日售菜详细</h4>
                <p class="list-group-item-text">&nbsp;</p>
            </a>
            <a href="@Url.Action("DailyReport", "Report" , new {id=5})" class="list-group-item">
                <h4 class="list-group-item-heading">Driver Daily Report 单日司机统计</h4>
                <p class="list-group-item-text">&nbsp;</p>
            </a>
            <a href="@Url.Action("NoDateReport", "Report" , new {id=6})" class="list-group-item">
                <h4 class="list-group-item-heading">All Customer Report 客户数据</h4>
                <p class="list-group-item-text">&nbsp;</p>
            </a>
            <a href="@Url.Action("NoDateReport", "Report" , new {id=9})" class="list-group-item">
                <h4 class="list-group-item-heading">Customer Order Report 客户点单数据</h4>
                <p class="list-group-item-text">&nbsp;</p>
            </a>

            <a href="@Url.Action("DailyReport", "Report" , new {id=10})" class="list-group-item">
                <h4 class="list-group-item-heading">Busy Hour Report  小时数据</h4>
                <p class="list-group-item-text">&nbsp;</p>
            </a>
        </div>

    </div>
</div>