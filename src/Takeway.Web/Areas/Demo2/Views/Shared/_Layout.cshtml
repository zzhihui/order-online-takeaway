@using Takeway.Web.Application.Extension
<!DOCTYPE html>
<!--[if lt IE 7 ]><html class="ie ie6" lang="en"> <![endif]-->
<!--[if IE 7 ]><html class="ie ie7" lang="en"> <![endif]-->
<!--[if IE 8 ]><html class="ie ie8" lang="en"> <![endif]-->
<!--[if (gte IE 9)|!(IE)]><!-->
<html>
<!--<![endif]-->

<head>

    <!-- Basic -->
    <meta charset="utf-8">
    <title>@ViewBag.Title</title>
    <meta name="author" content="IndaSoft Ltd">
    <meta name="keywords" content="Kingfood, kingfood.ie, online takeaway, demo takeaway">
    <meta name="description" content="">

    <!-- Mobile Specific Metas -->
    <meta name="viewport" content="width=device-width, initial-scale=1, maximum-scale=1">

    <!-- Libs CSS -->
    <link href="~/Areas/Demo2/Content/Client/css/bootstrap.css" rel="stylesheet">
    <link href="~/Areas/Demo2/Content/Client/css/font-awesome.min.css" rel="stylesheet">
    <link href="~/Areas/Demo2/Content/Client/css/flexslider.css" rel="stylesheet">
    <link href="~/Areas/Demo2/Content/Client/css/prettyPhoto.css" rel="stylesheet">
    <link href="~/Areas/Demo2/Content/Client/css/owl.carousel.css" rel="stylesheet">

    <!-- On Scroll Animations -->
    <link href="~/Areas/Demo2/Content/Client/css/animate.min.css" rel="stylesheet">

    <!-- Template CSS -->
    <link href="~/Areas/Demo2/Content/Client/css/style.css" rel="stylesheet">

    <!-- Custom Colors -->
    <!-- <link href="css/green.css" rel="stylesheet"> -->
    <!-- <link href="css/blue.css" rel="stylesheet"> -->
    <!-- <link href="css/tomato.css" rel="stylesheet"> -->
    <!-- <link href="css/turquoise.css" rel="stylesheet"> -->
    <!-- Responsive CSS -->
    <link href="~/Areas/Demo2/Content/Client/css/responsive.css" rel="stylesheet">

    <!-- Favicons -->
    <link rel="shortcut icon" href="~/favicon.ico">
    <link rel="apple-touch-icon" sizes="144x144" href="~/Areas/Demo2/Content/Client/img/icons/apple-touch-icon-144x144.png">
    <link rel="apple-touch-icon" sizes="114x114" href="~/Areas/Demo2/Content/Client/img/icons/apple-touch-icon-114x114.png">
    <link rel="apple-touch-icon" sizes="72x72" href="~/Areas/Demo2/Content/Client/img/icons/apple-touch-icon-72x72.png">
    <link rel="apple-touch-icon" href="~/Areas/Demo2/Content/Client/img/icons/apple-touch-icon.png">

    <!-- Google Fonts -->
    <link href='http://fonts.googleapis.com/css?family=Open+Sans:400,300italic,800italic,800,700italic,700,600italic,600,400italic,300' rel='stylesheet' type='text/css'>
    <link href='http://fonts.googleapis.com/css?family=Oswald:400,300,700' rel='stylesheet' type='text/css'>

    @Html.Partial(Html.Shared("_GoogleAnalytics.cshtml"))
  

</head>


<body>


    <!-- PRELOADER
    ============================================= -->
    <div class="animationload">
        <div class="loader"></div>
    </div>

    <!-- HEADER
    ============================================= -->
    <header id="header">
        <div class="navbar navbar-fixed-top">
            <div class="container">
                <!-- Navigation Bar -->
                <div class="navbar-header">

                    <!-- Responsive Menu Button -->
                    <button type="button" id="nav-toggle" class="navbar-toggle" data-toggle="collapse" data-target="#navigation-menu">
                        <span class="sr-only">Toggle navigation</span>
                        <span class="icon-bar"></span>
                        <span class="icon-bar"></span>
                        <span class="icon-bar"></span>
                    </button>

                    <!-- Logo Image -->
                    <a class="navbar-brand" href="@Url.Action("Index", "Home")"><img src="~/Areas/Demo2/Content/Client/img/logo.png" alt="logo" role="banner"></a>

                </div>	<!-- End Navigation Bar -->
                <!-- Navigation Menu -->
                <nav id="navigation-menu" class="collapse navbar-collapse" role="navigation">
                    <ul class="nav navbar-nav navbar-right">
                        <li><a id="GoToHome" class="selected-nav" href="@Url.Action("Index", "Home")">Home</a></li>
                        <li><a id="GoToMenu" href="@Url.Action("Index", "Order" )">Menu</a></li>
                        <li><a id="GoToAbout" href="@Url.Action("DeliveryArea", "Order")">Delivery Area</a></li>
                        <li>@{Html.RenderAction("BasketSummary", "Order");}</li>
                    </ul>
                </nav> <!-- End Navigation Menu -->

                

            </div>	 <!-- End container -->
        </div>	  <!-- End navbar fixed top  -->
</header> <!-- END HEADER -->
<div id="content_wrapper">
    <div id="spinner" style="margin: 0px; padding: 0px; position: fixed; right: 0px; top: 0px; width: 100%; height: 100%; background-color: #666666; z-index: 30001; opacity: .8; filter: alpha(opacity=70); display: none">
        <p style="position: absolute; top: 30%; left: 45%; color: White;">
            loading...<img src="@Url.Content("~/Content/loading.gif")" style="width: 100px; height: 100px;">
        </p>
    </div>
    @RenderBody()
    <footer id="footer">
        @Html.Partial(Html.Shared("_Footer.cshtml"))
        <!-- End container -->
    </footer> <!-- END FOOTER -->



</div>	<!-- END CONTENT WRAPPER -->
    <script src="~/Areas/Demo2/Content/Client/js/jquery-2.1.1.min.js" type="text/javascript"></script>
    <script src="~/Areas/Demo2/Content/Client/js/bootstrap.min.js" type="text/javascript"></script>
    <script src="~/Areas/Demo2/Content/Client/js/modernizr.custom.js" type="text/javascript"></script>
    <script src="~/Areas/Demo2/Content/Client/js/jquery.easing.js" type="text/javascript"></script>
    <script src="~/Areas/Demo2/Content/Client/js/retina.js" type="text/javascript"></script>
    <script src="~/Areas/Demo2/Content/Client/js/jquery.stellar.min.js" type="text/javascript"></script>
    <script src="~/Areas/Demo2/Content/Client/js/jquery.mb.YTPlayer.js" type="text/javascript"></script>
    <script defer src="~/Areas/Demo2/Content/Client/js/jquery.flexslider.js" type="text/javascript"></script>
    <script src="~/Areas/Demo2/Content/Client/js/jquery.parallax-1.1.3.js" type="text/javascript"></script>
    <script defer src="~/Areas/Demo2/Content/Client/js/count-to.js"></script>
    <script defer src="~/Areas/Demo2/Content/Client/js/jquery.appear.js"></script>
    <script src="~/Areas/Demo2/Content/Client/js/jquery.mixitup.js" type="text/javascript"></script>
    <script src="~/Areas/Demo2/Content/Client/js/jquery.prettyPhoto.js" type="text/javascript"></script>
    <script src="~/Areas/Demo2/Content/Client/js/owl.carousel.js" type="text/javascript"></script>
    <script src="~/Areas/Demo2/Content/Client/js/jquery.easypiechart.min.js"></script>
    <script defer src="~/Areas/Demo2/Content/Client/js/jquery.validate.min.js" type="text/javascript"></script>
    <script src="~/Areas/Demo2/Content/Client/js/waypoints.min.js" type="text/javascript"></script>
    <script src="~/Areas/Demo2/Content/Client/js/custom.js" type="text/javascript"></script>


    <!--[if lt IE 9]>
        <script src="https://oss.maxcdn.com/libs/html5shiv/3.7.0/html5shiv.js"></script>
        <script src="https://oss.maxcdn.com/libs/respond.js/1.3.0/respond.min.js"></script>
    <![endif]-->



</body>

</html>