@model Takeway.Web.ViewModels.Admin.DeliveryCostViewModel
@using Takeway.Web.Application.Extension


@{
    ViewBag.Title = "Edit Delivery Cost";
    Layout = Html.Shared("_LayoutAdmin.cshtml");
}
<div id="page-wrapper">
    <div class="well">
        <form class="form-horizontal" method="post">
            <fieldset>
                <legend>Edit</legend>
                <div class="text-danger">@Model.ErrorMessage</div>
                @Html.AntiForgeryToken()
                <div class="form-horizontal">
                    @Html.ValidationSummary(true, "", new { @class = "text-danger" })

                    <div class="form-group">
                        @Html.ActionLink("Back", "List", "DeliveryCost", null, new { @class = "btn btn-primary" })
                    </div>

                    <div class="form-group">
                        @Html.HiddenFor(model => model.SelectedDeliveryCost.Id)
                        <label class="col-lg-2 control-label">FromDistance</label>
                        <div class="col-md-10">
                            @Html.DisplayFor(model => model.SelectedDeliveryCost.FromDistance, new {htmlAttributes = new {@class = "form-control"}})
                        </div>
                    </div>
                    <div class="form-group">
                        <label class="col-lg-2 control-label">ToDistance</label>
                        <div class="col-md-10">
                            @Html.DisplayFor(model => model.SelectedDeliveryCost.ToDistance, new { htmlAttributes = new { @class = "form-control" } })
                        </div>
                    </div>

                    <div class="form-group">
                        <label class="col-lg-2 control-label">Cost</label>
                        <div class="col-md-10">
                            @Html.EditorFor(model => model.SelectedDeliveryCost.DeliveryCostAmount, new { htmlAttributes = new { @class = "form-control" } })
                        </div>
                    </div>

                    <div class="form-group">
                        <div class="col-md-offset-2 col-md-10">
                            <input type="submit" value="Update" class="btn btn-primary" />
                        </div>
                    </div>
                </div>

            </fieldset>
        </form>

    </div>
</div>
