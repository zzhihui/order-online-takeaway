@using Takeway.Web.Application.Extension
@model Takeway.Web.Models.LoginModel
@{
    ViewBag.Title = "Login";
    Layout = Html.Shared("_LayoutAdminHome.cshtml");
}
<div class="well">

    <form id="submitform" class="form-horizontal" method="post">
        <fieldset>
            <legend>Admin Login</legend>
            <p class="text-danger">@Html.ValidationSummary(true)</p>
            @Html.AntiForgeryToken()

            @*Login Info*@
            <div class="list-group">
                <div class="list-group-item">
                    <div class="form-group">

                        <label class="col-lg-2 control-label">User name</label>
                        <div class="col-lg-10 has-error">
                            @Html.TextBoxFor(t => t.UserName, new { @class = "form-control", @placeholder = "Enter user name" })
                            @Html.ValidationMessageFor(x => x.UserName)
                        </div>
                    </div>

                    <div class="form-group">

                        <label class="col-lg-2 control-label">Password</label>
                        <div class="col-lg-10 has-error">
                            @Html.PasswordFor(t => t.Password, new { @class = "form-control", @placeholder = "Enter password" })
                            @Html.ValidationMessageFor(x => x.Password)
                        </div>
                    </div>
                </div>
            </div>

            <div class="form-group">
                <div class="col-lg-10 col-lg-offset-2">
                    <button type="submit" class="btn btn-primary">Login</button>
                </div>
            </div>

        </fieldset>
    </form>

</div>