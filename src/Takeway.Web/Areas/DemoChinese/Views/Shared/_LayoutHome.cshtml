@using Takeway.Web.Application.Extension
<!DOCTYPE html>
<!--[if lt IE 7 ]><html class="ie ie6" lang="en"> <![endif]-->
<!--[if IE 7 ]><html class="ie ie7" lang="en"> <![endif]-->
<!--[if IE 8 ]><html class="ie ie8" lang="en"> <![endif]-->
<!--[if (gte IE 9)|!(IE)]><!-->
<html lang="en">
<!--<![endif]-->

<head>

    <!-- Basic -->
    <meta charset="utf-8">
    <title>@ViewBag.Title</title>
    <meta name="author" content="IndaSoft Ltd">
    @*TODO: Localisation*@
    <meta name="keywords" content="Kingfood, kingfood.ie, online takeaway, demo takeaway">
    <meta name="description" content="">

    <!-- Mobile Specific Metas -->
    <meta name="viewport" content="width=device-width, initial-scale=1, maximum-scale=1">

    <!-- Libs CSS -->
    @*TODO: Localisation*@
    <link href="~/Areas/DemoChinese/Content/Client/css/sitecss.min.css" rel="stylesheet" />
    
    <!-- Favicons -->
    <link rel="shortcut icon" href="~/favicon.ico">
    <link rel="apple-touch-icon" sizes="144x144" href="~/Areas/DemoChinese/Content/Client/img/icons/apple-touch-icon-144x144.png">
    <link rel="apple-touch-icon" sizes="114x114" href="~/Areas/DemoChinese/Content/Client/img/icons/apple-touch-icon-114x114.png">
    <link rel="apple-touch-icon" sizes="72x72" href="~/Areas/DemoChinese/Content/Client/img/icons/apple-touch-icon-72x72.png">
    <link rel="apple-touch-icon" href="~/Areas/DemoChinese/Content/Client/img/icons/apple-touch-icon.png">

    <!-- Google Fonts -->
    <link href="http://fonts.googleapis.com/css?family=Open+Sans:400,300italic,800italic,800,700italic,700,600italic,600,400italic,300" rel="stylesheet" type="text/css">
    <link href="http://fonts.googleapis.com/css?family=Oswald:400,300,700" rel="stylesheet" type="text/css">

    @Html.Partial(Html.Shared("_GoogleAnalytics.cshtml"))

</head>


<body>


<!-- PRELOADER
============================================= -->
<div class="animationload">
    <div class="loader"></div>
</div>


<!-- HEADER
============================================= -->
<header id="header">
    <div class="navbar navbar-fixed-top">
        <div class="container">
            <!-- Navigation Bar -->
            <div class="navbar-header">

                <!-- Responsive Menu Button -->
                <button type="button" id="nav-toggle" class="navbar-toggle" data-toggle="collapse" data-target="#navigation-menu">
                    <span class="sr-only">Toggle navigation</span>
                    <span class="icon-bar"></span>
                    <span class="icon-bar"></span>
                    <span class="icon-bar"></span>
                </button>

                <!-- Logo Image -->
                <a class="navbar-brand" href="#"><img src="~/Areas/DemoChinese/Content/Client/img/logo.png" alt="logo" role="banner"></a>

            </div> <!-- End Navigation Bar -->
            <!-- Navigation Menu -->
            <nav id="navigation-menu" class="collapse navbar-collapse" role="navigation">
                <ul class="nav navbar-nav navbar-right">
                    <li>
                        <a id="GoToHome" class="selected-nav" href="#intro">Home</a>
                    </li>
                    <li>
                        <a id="GoToApp" href="#app">App</a>
                    </li>
                    <li>
                        <a id="GoToMenu" href="@Url.Action("Index", "Order")">Menu</a>
                    </li>
                    <li>
                        <a id="GoToAbout" href="#about">About</a>
                    </li>
                    <li>
                        <a id="GoToContacts" href="#contact-info">Contacts</a>
                    </li>
                    <li>
                        <a id="GoToOrder" href="@Url.Action("Index", "Order")" class="selected-nav">Order Online</a>
                    </li>
                </ul>
            </nav> <!-- End Navigation Menu -->


        </div> <!-- End container -->
    </div> <!-- End navbar fixed top -->
</header> <!-- END HEADER -->
<!-- CONTENT WRAPPER
============================================= -->
<div id="content_wrapper">
    @RenderBody()
    <footer id="footer">
        @Html.Partial(Html.Shared("_Footer.cshtml"))
    </footer>
</div>
@*TODO: Localisation*@
<script src="~/Areas/DemoChinese/Content/Client/js/jquery-2.1.1.min.js" type="text/javascript"></script>
<script src="~/Areas/DemoChinese/Content/Client/js/bootstrap.min.js" type="text/javascript"></script>
<script src="~/Areas/DemoChinese/Content/Client/js/modernizr.custom.min.js" type="text/javascript"></script>
<script src="~/Areas/DemoChinese/Content/Client/js/jquery.easing.min.js" type="text/javascript"></script>
<script src="~/Areas/DemoChinese/Content/Client/js/retina.min.js" type="text/javascript"></script>
<script src="~/Areas/DemoChinese/Content/Client/js/jquery.stellar.min.js" type="text/javascript"></script>
<script src="~/Areas/DemoChinese/Content/Client/js/jquery.mb.YTPlayer.min.js" type="text/javascript"></script>
<script defer src="~/Areas/DemoChinese/Content/Client/js/jquery.flexslider.min.js" type="text/javascript"></script>
<script src="~/Areas/DemoChinese/Content/Client/js/jquery.parallax-1.1.3.es5.min.js" type="text/javascript"></script>
<script defer src="~/Areas/DemoChinese/Content/Client/js/count-to.min.js"></script>
<script defer src="~/Areas/DemoChinese/Content/Client/js/jquery.appear.min.js"></script>
<script src="~/Areas/DemoChinese/Content/Client/js/jquery.mixitup.min.js" type="text/javascript"></script>
<script src="~/Areas/DemoChinese/Content/Client/js/jquery.prettyPhoto.min.js" type="text/javascript"></script>
<script src="~/Areas/DemoChinese/Content/Client/js/owl.carousel.min.js" type="text/javascript"></script>
<script src="~/Areas/DemoChinese/Content/Client/js/jquery.easypiechart.min.js"></script>
<script defer src="~/Areas/DemoChinese/Content/Client/js/jquery.validate.min.js" type="text/javascript"></script>
<script src="~/Areas/DemoChinese/Content/Client/js/waypoints.min.js" type="text/javascript"></script>
<script src="~/Areas/DemoChinese/Content/Client/js/custom.min.js" type="text/javascript"></script>


<!--[if lt IE 9]>
    <script src="https://oss.maxcdn.com/libs/html5shiv/3.7.0/html5shiv.js"></script>
    <script src="https://oss.maxcdn.com/libs/respond.~/Areas/DemoChinese/Content/Client/js/1.3.0/respond.min.js"></script>
<![endif]-->
</body>

</html>