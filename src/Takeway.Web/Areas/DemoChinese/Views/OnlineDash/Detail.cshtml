@using Core.Common.Utility.Extension
@using Takeaway.Service.Extension
@using Takeway.Web.Application.Extension
@model Takeway.Web.Models.OnlineDash.OnlineDashViewModel
@{

    Layout = Html.Shared("_LayoutAdmin.cshtml");
}
<div id="page-wrapper">
    <h2>Order Detail</h2>

    <div class="well">

        <div class="list-group">


            <div class="list-group-item row">
                <div class="col-lg-2">
                    <h5>Order Ref</h5>
                </div>
                <div class="col-lg-10">
                    <h5>@Model.SelectedOrder.OrderRef</h5>
                </div>
            </div>

        </div>

        @*order items*@
        <div class="list-group">

            @foreach (var item in Model.SelectedOrder.OrderItems)
            {
                <div class="list-group-item row">
                    <div class="col-lg-2">@item.Name</div>
                    <div class="col-lg-10">
                        <label class="form-control-static">@item.Price.ToPriceStringIe()</label>
                        <span class="help-block">@item.SubItemWithComment()</span>
                        <span class="help-block">@item.Comment</span>
                    </div>
                </div>
            }

            <div class="list-group-item row">
                <div class="col-lg-2">&nbsp;</div>
                <div class="col-lg-10">@Model.SelectedOrder.Comment</div>
            </div>


        </div>

        <div class="list-group">
            <div class="list-group-item row">
                <div class="col-lg-4 col-lg-offset-8">
                    <h6>Order Total:&nbsp; @Model.SelectedOrder.OrderTotal.ToPriceStringIe()</h6>
                </div>
            </div>
            <div class="list-group-item row">
                <div class="col-lg-4 col-lg-offset-8">
                    <h6>@Model.SelectedOrder.DeliveryType.Name</h6>
                </div>
            </div>
            <div class="list-group-item row">
                <div class="col-lg-4 col-lg-offset-8">
                    <h6>Delivery Charge:&nbsp; @Model.SelectedOrder.DeliveryCharge.ToPriceStringIe()</h6>
                </div>
            </div>
            <br/>
            <div class="list-group-item row">
                <div class="col-lg-4 col-lg-offset-8">
                    <h4>Total:&nbsp; @((Model.SelectedOrder.OrderTotal + Model.SelectedOrder.DeliveryCharge).ToPriceStringIe())</h4>
                </div>
            </div>
            <div class="list-group-item row">
                <div class="col-lg-4 col-lg-offset-8">
                    @if (string.IsNullOrEmpty(Model.SelectedOrder.PaymentRef))
                    {
                    <h4>Pay Later</h4>
                    }
                    else
                    {
                    <h4>Paid Online</h4>
                    }

                </div>
            </div>
            <div class="list-group-item row">
                <div class="col-lg-4 col-lg-offset-8">
                    <h6>Order Time: &nbsp; @Model.SelectedOrder.Created.ToDateTimeUtcFormat()</h6>
                </div>
            </div>
        </div>

    </div>
</div>