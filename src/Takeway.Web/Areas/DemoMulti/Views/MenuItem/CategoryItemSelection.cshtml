@model Takeway.Web.Models.Admin.MenuItemViewModel

@using Core.Common.Utility.Extension
@using Takeway.Web.Application.Extension
@{
    ViewBag.Title = "Add Selection";
    Layout = Html.Shared("_LayoutAdmin.cshtml");
}
<div class="well">
    <form class="form-horizontal text-info" method="post">
        <fieldset>
            <legend>Update</legend>
            <div class="text-danger">@Model.ErrorMessage</div>
            @Html.AntiForgeryToken()
            <div class="form-horizontal">
                @Html.ValidationSummary(true, "", new { @class = "text-danger" })

                <div class="form-group">
                    @Html.ActionLink("Back", "List", "MenuItem", null, new { @class = "btn btn-primary" })
                    @Html.HiddenFor(m => m.EditMenuItem.Id)
                    @Html.HiddenFor(m => m.EditMenuItem.SubItemSelections)
                </div>

                <div class="row">
                    <table class="table table-striped table-hover">
                        <thead>
                            <tr>
                                <th>Name:</th>
                                <th>Description:</th>
                            </tr>
                        </thead>
                        <tbody>

                            @foreach (var entry in Model.EditMenuItem.SubItemSelections)
                            {
                                <tr>
                                    <td>@Html.Raw(entry.Name)</td>
                                    <td>
                                        @Html.Raw(entry.Description)
                                    </td>
                                    <td>
                                        @Html.ActionLink("Remove", "RemoveSubItemItem", new { id = entry.Id, itemId = Model.EditMenuItem.Id })
                                    </td>
                                </tr>

                            }
                        </tbody>
                    </table>
                </div>

                <div class="form-group">
                    <label class="col-lg-2 control-label">Description</label>
                    <div class="col-md-10">
                        @Html.DropDownListFor(r => r.SelectedMenuItemId, new SelectList(@Model.MenuSubItems, "Id", "Description"), new { @class = "form-control" })
                    </div>
                </div>
                <div class="form-group">
                    <div class="col-lg-2">
                        &nbsp;
                    </div>
                    <div class="col-lg-10">
                        <input type="submit" value="Add" class="btn btn-primary" />
                    </div>
                </div>

            </div>

        </fieldset>
    </form>

</div>
