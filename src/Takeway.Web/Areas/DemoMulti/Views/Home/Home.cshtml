@using Core.Common.Utility.Extension
@using Takeway.Web.Application.Extension
@model Takeway.Web.ViewModels.Order.OrderViewModel
@{
    Layout = @Html.Shared("_LayoutHome.cshtml");
}
<header>
    <div class="container">
        <div class="intro-text">
            <!-- TODO:Localisation -->
            <div class="bs-example">
                <div id="myCarousel" class="carousel slide" data-interval="3000" data-ride="carousel">
                    <!-- Carousel indicators -->
                    <ol class="carousel-indicators">
                        <li data-target="#myCarousel" data-slide-to="0" class="active"></li>
                        <li data-target="#myCarousel" data-slide-to="1"></li>
                        <li data-target="#myCarousel" data-slide-to="2"></li>
                    </ol>
                    <!-- Wrapper for carousel items -->
                    <div class="carousel-inner">
                        <div class="item">
                            <img class="visible-xs" src="@Html.Content("pic/slider-bg-1-mob.jpg")" alt="">
                            <img class="hidden-xs" src="@Html.Content("pic/slider-bg-1.jpg")" alt="">
                            <div class="carousel-caption">
                                <div class="slider-caption">
                                    <h2>
                                        FOOD MADE FRESH IN <br>
                                        OUR KITCHENS DAILY
                                    </h2>
                                    <h4><i>Fish delivered twice daily for <br>the freshest, mouth-watering sushi</i></h4>
                                </div>
                            </div>
                        </div>
                        <div class="item">
                            <img class="visible-xs" src="@Html.Content("pic/slider-bg-2-mob.jpg")" alt="">
                            <img class="hidden-xs" src="@Html.Content("pic/slider-bg-2.jpg")" alt="">
                            <div class="carousel-caption">
                                <div class="slider-caption">
                                    <h2>
                                        ORDER DELIVERY TO YOUR <br>HOME, OFFICE OR PARTY
                                    </h2>
                                    <h4><i>Musashi - made easy to eat </i></h4>
                                </div>
                            </div>
                        </div>
                        <div class="item active">
                            <img class="visible-xs" src="@Html.Content("pic/slider-bg-3-mob.jpg")" alt="">
                            <img class="hidden-xs" src="@Html.Content("pic/slider-bg-3.jpg")" alt="">
                            <div class="carousel-caption">
                                <div class="slider-caption">
                                    <h2>
                                        THE SECRET OF<br>LONGER LIFE
                                    </h2>
                                    <h4><i>Eat raw fish &amp; drink green tea</i></h4>
                                </div>
                            </div>
                        </div>
                    </div>
                    <!-- Carousel controls -->
                    <a class="carousel-control left" href="#myCarousel" data-slide="prev">
                        <span class="glyphicon glyphicon-chevron-left"></span>
                    </a>
                    <a class="carousel-control right" href="#myCarousel" data-slide="next">
                        <span class="glyphicon glyphicon-chevron-right"></span>
                    </a>
                </div>
            </div>
            <a href="#order" class="page-scroll btn btn-xl">View Our Menu</a>
        </div>
    </div>
</header>

<!-- Order Section -->
<section id="order" class="bg-light-gray">
    <div class="container">
        <div class="row">
            <div class="col-lg-12 text-center">
                <h2 class="section-heading">Choose a Location</h2>
                <h3 class="section-subheading text-muted">Click on one of our shops below.</h3>
            </div>
        </div>
        <!-- TODO:Localisation -->
        <div class="row">
            <div class="col-sm-4">
                <div class="team-member">
                    <a href="@Url.Action("Index", "order")"><img src="@Html.Content("pic/shop-icon.png")" class="img-responsive img-circle" alt=""></a>
                    <a href="@Url.Action("Index", "order")" class="page-scroll btn btn-xl">Order Now</a>
                    <h4>Musashi Capel St</h4>
                    <p class="text-muted">15 Capel Street, Dublin 1<br />01-532 80 68<br />01-532 80 57<br /></p>
                    <p class="text-muted">Sun -Thurs: 5:00pm - 12:30am<br />Fri -Sat: 5:00pm - 01:00am</p>

                </div>
            </div>
            <div class="col-sm-4">
                <div class="team-member">
                    <a href="@Url.Action("Index", "order")"><img src="@Html.Content("pic/shop-icon.png")" class="img-responsive img-circle" alt=""></a>
                    <a href="@Url.Action("Index", "order")" class="page-scroll btn btn-xl">Order Now</a>
                    <h4>Musashi IFSC</h4>
                    <p class="text-muted">Unit 2, Burton Hall, Custom house Square, Mayor Street, Dublin 1<br />01-555 73 73<br />01-535 80 87<br />ifsc@musashidublin.com</p>
                    <p class="text-muted">Sun -Thurs: 5:00pm - 12:30am<br />Fri -Sat: 5:00pm - 01:00am</p>
                </div>
            </div>
            <div class="col-sm-4">
                <div class="team-member">
                    <a href="@Url.Action("Index", "order")"><img src="@Html.Content("pic/shop-icon.png")" class="img-responsive img-circle" alt=""></a>
                    <a href="@Url.Action("Index", "order")" class="page-scroll btn btn-xl">Order Now</a>
                    <h4>Musashi Sandyford</h4>
                    <p class="text-muted">Apex Business Centre Blackthorn Road, Sandyford, Dublin 18<br />01-534 43 36<br /></p>
                    <p class="text-muted">Sun -Thurs: 5:00pm - 12:30am<br />Fri -Sat: 5:00pm - 01:00am</p>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- App Section -->
<section id="app">
    <div class="container">
        <div class="row">
            <div class="row">
                <div class="col-lg-12 text-center">
                    <h2 class="section-heading">Apps</h2>
                    <h3 class="section-subheading text-muted">Download our App.</h3>
                </div>
            </div>
            <div class="row text-center">
                <div class="col-md-4">

                    <!-- TODO:Localisation -->
                    <a href="#" target="_blank"><img src="/Content/googleplay.png" class="img-responsive" alt="Google Play" width="200" height="100"></a>
                    <a href="#" target="_blank"><img src="/Content/applestore.png" class="img-responsive" alt="Apple itunes" width="200" height="100"></a>
                </div>
                <div class="col-md-6">
                    <p class="text-muted">

                        Now you can order from us even easier than ever. Just download the app using one of the links and then you'll be able to find out all the latest news, exclusive offers and opening times, whilst ordering with a few touches of your phone or tablet.

                        What are you waiting for? Download now!
                    </p>
                </div>
            </div>
        </div>
        <br />
        <br />
    </div>
</section>


<!-- Menu Section -->
<section id="menu" class="bg-light-gray">
    <div class="container">
        <div class="intro-text">
            <div class="row">
                <div class="col-lg-12 text-center">
                    <h2 class="section-heading">Here is our Menu</h2>
                </div>
            </div>
            <div class="menu-slide">
                <div id="menuSlide" class="carousel slide" data-ride="carousel">
                    <!-- Carousel indicators -->
                    <ol class="carousel-indicators">
                        <li data-target="#menuSlide" data-slide-to="0" class="active"></li>
                        <li data-target="#menuSlide" data-slide-to="1"></li>

                    </ol>
                    <!-- Wrapper for carousel items -->
                    <div class="carousel-inner">
                        <div class="item">
                            <img class="visible-xs" src="@Html.Content("pic/menu1.jpg")" alt="">
                            <img class="hidden-xs" src="@Html.Content("pic/menu1.jpg")" alt="">
                        </div>
                        <div class="item active">
                            <img class="visible-xs" src="@Html.Content("pic/menu2.jpg")" alt="">
                            <img class="hidden-xs" src="@Html.Content("pic/menu2.jpg")" alt="">
                        </div>
                    </div>
                    <!-- Carousel controls -->
                    <a class="carousel-control left" href="#menuSlide" data-slide="prev">
                        <span class="glyphicon glyphicon-chevron-left"></span>
                    </a>
                    <a class="carousel-control right" href="#menuSlide" data-slide="next">
                        <span class="glyphicon glyphicon-chevron-right"></span>
                    </a>
                </div>
            </div>
            <div class="text-center">
                <a href="@Url.Action("Index", "order")" class="page-scroll btn btn-xl">Order Now</a>
            </div>

        </div>

    </div>
</section>

<!-- About Section -->
<section id="about" class="bg-light-gray">
    <div class="container">
        <div class="row">
            <div class="col-md-4">
                <!-- TODO:Localisation -->
                <iframe src="https://www.facebook.com/plugins/page.php?href=https%3A%2F%2Fwww.facebook.com%2Fmusashi.dublin&tabs=timeline&width=340&height=500&small_header=false&adapt_container_width=true&hide_cover=false&show_facepile=true&appId" width="340" height="500" style="border: none; overflow: hidden" scrolling="no" frameborder="0" allowTransparency="true"></iframe>
            </div>
            <div class="col-md-8">
                <!-- TODO:Localisation -->
                <h2 class="section-heading">WHO WE ARE</h2>
                <p>We are a Chinese Take-Aways in the Dublin area. The excellent taste and high quality of the food is matched by our excellent service and express delivery.</p>
                <h2 class="section-heading">WHAT WE DO</h2>
                <p>We believe in the best. We guarantee 100% natural, fresh and healthy food cooked to your order preference. Lin Kee brings you the best fresh food daily. We aim to provide top quality hot dishes for our customers</p>
                <h2 class="section-heading">WHAT MAKES US BETTER</h2>
                <ul>
                    <li>Quality Asian Cuisine at excellent prices</li>
                    <li>Special Eurosaver Meal Deals during week days</li>
                    <li>Customers can see their order being made before their eyes through our open kitchen</li>
                    <li>A team with the most experienced, highly skilled chefs in the country</li>
                    <li>Our house secret recipe for sauces made by a well known professional chef… this makes us unbeatable!</li>

                </ul>
                <h2 class="section-heading">Latest News</h2>
                <div class="list-group">
                    @foreach (var shopNewsItem in Model.ShopInfo.ShopNews) {
                        <div class="list-group-item">
                            <span class="glyphicon glyphicon-comment"></span> <span class="badge">@shopNewsItem.Created.ToDateUtcFormat()</span>
                            @shopNewsItem.News
                            <span>&nbsp;</span>
                        </div>
                    }
                </div>
               </div>
        </div>
    </div>
</section>

