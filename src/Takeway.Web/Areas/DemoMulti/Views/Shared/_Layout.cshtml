
@using System.Configuration
@using System.Reflection
@using Takeway.Web.Application.Extension
@using Takeway.Web.Controllers
<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <meta http-equiv="X-UA-Compatible" content="IE=edge">

    @*TODO: Localisation*@
    <title>Asian Food Dublin | Chinese & Thai Takeaway | Demo Takeaway</title>
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta name="description" content="Chinese Takeaway | Thai Takeaway | Asian Food | Order Online | Takeaway Delivery | Artane | North Strand | Glasnevin | Swords | Lin Kee Takeaways Dublin" />
    <meta name="author" content="">

    <!-- Custom Fonts -->
    <link href="@Html.Content("font-awesome/css/font-awesome.min.css")" rel="stylesheet" type="text/css">
    <link href="https://fonts.googleapis.com/css?family=Montserrat:400,700" rel="stylesheet" type="text/css">
    <link href='https://fonts.googleapis.com/css?family=Kaushan+Script' rel='stylesheet' type='text/css'>
    <link href='https://fonts.googleapis.com/css?family=Droid+Serif:400,700,400italic,700italic' rel='stylesheet' type='text/css'>
    <link href='https://fonts.googleapis.com/css?family=Roboto+Slab:400,100,300,700' rel='stylesheet' type='text/css'>

    <!-- Google Tracking -->
    @Html.Partial(@Html.Shared("_GoogleAnalytics.cshtml"))

    <!-- Bootstrap Core CSS -->
    <link href="@Html.Content("css/bootstrap.min.css")" rel="stylesheet">
    <!-- Custom CSS -->
    <link href="@Html.Content("css/custom.css")" rel="stylesheet">

    <!-- HTML5 Shim and Respond.js IE8 support of HTML5 elements and media queries -->
    <!-- WARNING: Respond.js doesn't work if you view the page via file:// -->
    <!--[if lt IE 9]>
        <script src="https://oss.maxcdn.com/libs/html5shiv/3.7.0/html5shiv.js"></script>
        <script src="https://oss.maxcdn.com/libs/respond.js/1.4.2/respond.min.js"></script>
    <![endif]-->
</head>
<body id="page-top" class="index">

<nav class="navbar navbar-default navbar-fixed-top">
    <div class="container">
        <!-- Brand and toggle get grouped for better mobile display -->
        <div class="navbar-header page-scroll">
            <button type="button" class="navbar-toggle" data-toggle="collapse" data-target="#bs-example-navbar-collapse-1">
                <span class="sr-only">Toggle navigation</span>
                <span class="icon-bar"></span>
                <span class="icon-bar"></span>
                <span class="icon-bar"></span>
            </button>
            <a class="navbar-brand page-scroll" href="@Url.Action("Index", "order")">Demo Takeaway</a>
            @*<a class="navbar-brand page-scroll" href="@Url.Action("Index", "order")"><img src="../../Content/pic/logo.png" class="img-responsive" alt="Musashi" height="80" width="200"></a>*@
         
        </div>
        <!-- Collect the nav links, forms, and other content for toggling -->
        <div class="collapse navbar-collapse" id="bs-example-navbar-collapse-1">
            <ul class="nav navbar-nav navbar-right">
                <li>
                    <a class="page-scroll" href="@Url.Action("Index", "order")">Menu</a>
                </li>
                <li>
                    <a class="page-scroll" href="@Url.Action("DeliveryArea", "order")">Delivery Area</a>
                </li>
            </ul>
        </div>
        <div class="navbar-header pull-right">
            <ul class="nav navbar-nav">
                <li class="label-danger">@{Html.RenderAction("BasketSummary", "Order");}</li>
            </ul>
        </div>
        <!-- /.navbar-collapse -->
    </div>
    <!-- /.container-fluid -->
</nav>
    <br/>
    <div id="spinner" style="margin: 0px; padding: 0px; position: fixed; right: 0px; top: 0px; width: 100%; height: 100%; background-color: #666666; z-index: 30001; opacity: .8; filter: alpha(opacity=70); display: none">
        <p style="position: absolute; top: 30%; left: 45%; color: White;">
            loading...<img src="@Url.Content("~/Content/loading.gif")" style="width: 100px; height: 100px;">
        </p>
    </div>
    @RenderBody()
    <a href="#0" class="cd-top">Top</a>
    <!-- Footer -->
    <footer>
        <div class="container">
            <div class="row">
                <div class="col-md-4">
                    <!-- TODO:Localisation -->
                    <span class="copyright"> &copy; @DateTime.Now.Year - DemoMulti.Kingfood.ie. <br /><a href="http://www.indasoft.ie" target="_blank">Powered by IndaSoft</a></span>
                </div>
                <div class="col-md-4">
                    <ul class="list-inline social-buttons">
                        <li>
                            <a href="#"><i class="fa fa-twitter"></i></a>
                        </li>
                        <li>
                            <a href="#"><i class="fa fa-facebook"></i></a>
                        </li>
                        <li>
                            <a href="#"><i class="fa fa-linkedin"></i></a>
                        </li>
                    </ul>
                </div>
                <div class="col-md-4">
                    <ul class="list-inline quicklinks">
                        <li>
                            <a href="#">Privacy Policy</a>
                        </li>
                        <li>
                            <a href="#">Terms of Use</a>
                        </li>
                    </ul>
                </div>
            </div>
        </div>
    </footer>



    @Scripts.Render("~/bundles/jquery")
    @Scripts.Render("~/bundles/bootstrap")
    @Scripts.Render("~/bundles/jqueryval")
    <!-- Plugin JavaScript -->
    <script src="http://cdnjs.cloudflare.com/ajax/libs/jquery-easing/1.3/jquery.easing.min.js"></script>
    <script src="@Html.Content("js/classie.js")"></script>
    <script src="@Html.Content("js/cbpAnimatedHeader.js")"></script>
    <!-- Contact Form JavaScript -->
    <script src="@Html.Content("js/jqBootstrapValidation.js")"></script>
    <script src="@Html.Content("js/contact_me.js")"></script>
    <!-- Custom Theme JavaScript -->
    <script src="@Html.Content("js/custom.js")"></script>

    @RenderSection("scripts", required: false)
</body>
</html>
