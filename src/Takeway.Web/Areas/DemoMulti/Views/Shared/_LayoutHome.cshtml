
@using System.Configuration
@using System.Reflection
@using Takeway.Web.Application.Extension
@using Takeway.Web.Controllers
<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <meta http-equiv="X-UA-Compatible" content="IE=edge">

    @*TODO: Localisation*@
    <title>Asian Food Dublin | Chinese & Thai Takeaway | Demo Takeaway</title>
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta name="description" content="Chinese Takeaway | Thai Takeaway | Asian Food | Order Online | Takeaway Delivery | Artane | North Strand | Glasnevin | Swords | Lin Kee Takeaways Dublin" />
