    <![endif]-->
    <script type="text/javascript">
    window.cookieconsent_options = {"message":"This website uses cookies to ensure you get the best experience on our website","dismiss":"I agree","learnMore":"More info","link":"http://www.kingfood.ie/home/privacypolicy","theme":"dark-top"};
