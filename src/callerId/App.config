<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <configSections>
    <section name="log4net" type="log4net.Config.Log4NetConfigurationSectionHandler,Log4net"/>
  </configSections>
  <appSettings>
    <add key="DbHost" value="localhost"/>
    <add key="UseRedisData" value="false" />
    <add key="TestMode" value="true" />
    <add key="ShopId" value="1" />
  </appSettings>
  <log4net>
    <root>
      <level value="DEBUG"/>
      <appender-ref ref="Default"/>
      <appender-ref ref="Errors"/>
      <appender-ref ref="Debug"/>
    </root>

    <!-- Logs all messages based on root message level and rolls files daily -->
    <appender name="Default" type="log4net.Appender.RollingFileAppender">
      <file value="D:\Logs\callerid.log"/>
      <appendToFile value="true"/>
      <rollingStyle value="Date"/>
      <datePattern value="yyyyMMdd"/>
      <layout type="log4net.Layout.PatternLayout">
        <conversionPattern value="%date [%thread] %-5level %logger [%ndc] - %message%newline"/>
      </layout>
    </appender>

    <!-- Logs only Errors messages and above to a separate file and rolls daily -->
    <appender name="Errors" type="log4net.Appender.RollingFileAppender">
      <file value="D:\Logs\errorcallerid.log"/>
      <appendToFile value="true"/>
      <rollingStyle value="Date"/>
      <datePattern value="yyyyMMdd"/>
      <layout type="log4net.Layout.PatternLayout">
        <conversionPattern value="%date [%thread] %-5level %logger [%ndc] - %message%newline"/>
      </layout>
      <threshold value="ERROR"/>
    </appender>

    <!-- Logs only Debug messages (for development testing) and rolls files based on size -->
    <appender name="Debug" type="log4net.Appender.RollingFileAppender">
      <file value="D:\Logs\debugcallerid.log"/>
      <appendToFile value="true"/>
      <rollingStyle value="Size"/>
      <maxSizeRollBackups value="10"/>
      <maximumFileSize value="10MB"/>
      <staticLogFileName value="true"/>
      <layout type="log4net.Layout.PatternLayout">
        <conversionPattern value="%date [%thread] %-5level %logger [%ndc] - %message%newline"/>
      </layout>
      <filter type="log4net.Filter.LevelMatchFilter">
        <levelToMatch value="DEBUG"/>
      </filter>
      <filter type="log4net.Filter.DenyAllFilter"/>
    </appender>

  </log4net>
  <startup>
    <supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.5"/>
  </startup>
</configuration>
