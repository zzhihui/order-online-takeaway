<UserControl
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:converters="clr-namespace:Takeaway.Admin.Wpf.Utility.Converters"
             xmlns:i="http://schemas.microsoft.com/expression/2010/interactivity"
             xmlns:cal="http://www.caliburnproject.org"
             xmlns:Controls="clr-namespace:System.Windows.Controls;assembly=System.Windows.Controls.Input.Toolkit" 
             x:Class="Takeaway.Admin.Wpf.Views._CustomerInfo"
             mc:Ignorable="d" 
             d:DesignHeight="900" d:DesignWidth="200">
    <UserControl.Resources>


        <converters:BoolToVisibleConverter x:Key="BoolToVisibleConverter"/>
    </UserControl.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <StackPanel Orientation="Vertical" Grid.Row="1">
            <Label Content="Email" Style="{DynamicResource WhiteLabel}"/>
            <TextBox TextWrapping="Wrap" Text="{Binding CustomerEmail}" Width="auto" Height="30"/>
        </StackPanel>

        <StackPanel Orientation="Vertical" Grid.Row="2">
            <Label Content="Contact Name"  Style="{DynamicResource WhiteLabel}"/>
            <TextBox TextWrapping="Wrap" Text="{Binding CustomerName}" Width="auto" Height="30"/>
        </StackPanel>

        <StackPanel Orientation="Vertical" Grid.Row="3">
            <Label Content="Phone"  Style="{DynamicResource WhiteLabel}"/>
            <TextBox TextWrapping="Wrap" Text="{Binding CustomerPhone}" Width="auto" Height="30"/>
        </StackPanel>
        <StackPanel Orientation="Vertical" Grid.Row="4">
            <Label Content="Address" Style="{DynamicResource WhiteLabel}"/>
            <Controls:AutoCompleteBox Text="{Binding CustomerAddress,Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Width="Auto" ItemsSource="{Binding AddressList}" Height="30">
                <i:Interaction.Triggers>
                    <i:EventTrigger EventName="Populating">
                        <cal:ActionMessage MethodName="DoAddressSuggestion"/>
                    </i:EventTrigger>
                </i:Interaction.Triggers>
            </Controls:AutoCompleteBox>
            <Button Content="Customer Lookup" Width="Auto"  Visibility="{Binding AddressLookupFeature, Converter={StaticResource BoolToVisibleConverter}}" Height="35" Style="{DynamicResource YellowButton}">
                <i:Interaction.Triggers>
                    <i:EventTrigger EventName="Click">
                        <cal:ActionMessage MethodName="DoAddressLookup"/>
                    </i:EventTrigger>
                </i:Interaction.Triggers>
            </Button>
        </StackPanel>
        <StackPanel Orientation="Vertical" Grid.Row="5">

            <StackPanel Orientation="Vertical"  Visibility="{Binding TakeawayVisible, Converter={StaticResource BoolToVisibleConverter}}">
                <Label Content="{Binding SelectedDeliveryOptionDisplay}" Style="{DynamicResource WhiteLargeLabel}"/>
                <ListView ItemsSource="{Binding DeliveryOptionDisplay}" SelectionMode="Single" SelectedItem="{Binding SelectedDeliveryOptionDisplay}" Background="Transparent" 
                          Visibility="{Binding Path=TakeawayVisible, Converter={StaticResource BoolToVisibleConverter}}">
                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <Border BorderBrush="Orange" BorderThickness="2">
                                <Grid Background="#DA542D">
                                    <ToggleButton IsChecked="{Binding RelativeSource={RelativeSource Mode=FindAncestor,AncestorType={x:Type ListBoxItem}},Path=IsSelected}"  Style="{DynamicResource ToggleSelectDeliveryOption}" IsManipulationEnabled="false" Content="{Binding}"/>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </StackPanel>
        </StackPanel>

        <StackPanel Orientation="Vertical" Grid.Row="6"  Margin="0,10,0,0">
            <Label Content="{Binding Email}"  Style="{DynamicResource WhiteLargeLabel}"/>
            <Label Content="{Binding PhoneNumber}"  Style="{DynamicResource WhiteLargeLabel}"/>

        </StackPanel>




    </Grid>




</UserControl>
