<UserControl
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:Takeaway.Admin.Wpf.Views"
             
             xmlns:xctk="http://schemas.xceed.com/wpf/xaml/toolkit"
             x:Class="Takeaway.Admin.Wpf.Views._PosControl" 
             mc:Ignorable="d" 
             d:DesignHeight="600" d:DesignWidth="800">
    <xctk:BusyIndicator IsBusy="{Binding IsBusy}" BusyContent="Please wait..." >
        <Grid>
            <Grid.RowDefinitions>


                <RowDefinition Height="190" />
                <RowDefinition Height="30" />
                <RowDefinition Height="50" />
                <RowDefinition Height="80" />
                <RowDefinition Height="200*" />
                <RowDefinition Height="200" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="300*"/>
                <ColumnDefinition Width="70"/>
                <ColumnDefinition Width="200"/>
                <ColumnDefinition Width="130"/>

            </Grid.ColumnDefinitions>

            <local:_Category Grid.Column="0" Grid.Row="0" />
            <local:_CategoryB Grid.Column="0" Grid.Row="1" Grid.RowSpan="2"/>
            <local:_HotItems Grid.Column="0" Grid.Row="3" />
            <local:_CategoryItems Grid.Column="0" Grid.Row="4" Grid.RowSpan="2"  />

            <local:_OptionExtra Grid.Column="1" Grid.Row="0" Grid.RowSpan="6"/>
            <local:_OrderSummary Grid.Column="2" Grid.Row="0" Grid.RowSpan="6"/>

            <local:_CustomerInfo Grid.Column="3" Grid.Row="0" Grid.RowSpan="5"/>
            <local:_OrderTotal Grid.Column="3" Grid.Row="5" />



        </Grid>
    </xctk:BusyIndicator>
</UserControl>
