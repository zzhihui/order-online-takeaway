<UserControl x:Class="Takeaway.Admin.Wpf.Views._OrderTotal"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
          
             xmlns:converters="clr-namespace:Takeaway.Admin.Wpf.Utility.Converters"
             xmlns:i="http://schemas.microsoft.com/expression/2010/interactivity"
             xmlns:cal="http://www.caliburnproject.org"
             mc:Ignorable="d" 
             d:DesignHeight="300" d:DesignWidth="200">
    <UserControl.Resources>
        <converters:PriceConverter x:Key="PriceConverter" />
        <converters:BoolToVisibleConverter x:Key="BoolToVisibleConverter"></converters:BoolToVisibleConverter>
    </UserControl.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="70" />
        </Grid.RowDefinitions>
        <StackPanel Orientation="Horizontal" Grid.Row="0">
            <Label Content="Discount" HorizontalAlignment="Right"  Style="{DynamicResource LabelSmallOrderNumber}"/>
            <Label Content="{Binding DiscountAmount, Converter={StaticResource PriceConverter}}" HorizontalAlignment="Left" Style="{DynamicResource LabelSmallOrderNumber}"/>
        </StackPanel>
        <Label Content="Delivery Charge:" HorizontalAlignment="Left"  Style="{DynamicResource LabelSmallOrderNumber}" Grid.Row="1"
                   Visibility="{Binding Path=TakeawayVisible, Converter={StaticResource BoolToVisibleConverter}}"/>
        <StackPanel Orientation="Horizontal" Grid.Row="2" >

            <Button x:Name="DoDeliveryAdd" Content=" + "  Style="{DynamicResource ButtonSmallDeliveryCharge}"  Visibility="{Binding Path=TakeawayVisible, Converter={StaticResource BoolToVisibleConverter}}">
                <i:Interaction.Triggers>
                    <i:EventTrigger EventName="Click">
                        <cal:ActionMessage MethodName="DoDeliveryAdd">
                        </cal:ActionMessage>
                    </i:EventTrigger>
                </i:Interaction.Triggers>
            </Button>
            <TextBox TextWrapping="Wrap" Text="{Binding DeliveryCharge, Converter={StaticResource PriceConverter}}" MinWidth="50"
                     IsEnabled="{Binding DeliveryOptionEditable}"
                     Visibility="{Binding Path=TakeawayVisible, Converter={StaticResource BoolToVisibleConverter}}"/>
            <Button x:Name="DoDeliveryReduce" Content=" - " Style="{DynamicResource ButtonSmallDeliveryCharge}"  Visibility="{Binding Path=TakeawayVisible, Converter={StaticResource BoolToVisibleConverter}}">
                <i:Interaction.Triggers>
                    <i:EventTrigger EventName="Click">
                        <cal:ActionMessage MethodName="DoDeliveryReduce">
                        </cal:ActionMessage>
                    </i:EventTrigger>
                </i:Interaction.Triggers>
            </Button>
        </StackPanel>

        <StackPanel Orientation="Horizontal" Grid.Row="3">
            <Label Content="Total:" HorizontalAlignment="Right"  Style="{StaticResource LabelLargeOrderTotal}"/>
            <Label Content="{Binding OrderTotal, Converter={StaticResource PriceConverter}}" HorizontalAlignment="Left" Style="{StaticResource LabelLargeOrderTotal}"/>
        </StackPanel>
        <Button x:Name="DoCompleteOrder" Content="Complete Order"  Grid.Row="4"  Style="{StaticResource ButtonLargeCompleteOrder}">
            <i:Interaction.Triggers>
                <i:EventTrigger EventName="Click">
                    <cal:ActionMessage MethodName="DoCompleteOrder">
                    </cal:ActionMessage>
                </i:EventTrigger>
            </i:Interaction.Triggers>
        </Button>








    </Grid>
</UserControl>
