<UserControl x:Class="Takeaway.Admin.Wpf.Views._ErrorMessage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             mc:Ignorable="d" 
             d:DesignHeight="300" d:DesignWidth="300">
    <UserControl.Resources>
        <Style x:Key="TextBlock" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="Bold" />
        </Style>

    </UserControl.Resources>
    <Grid>
        <TextBlock HorizontalAlignment="Stretch" Margin="0,0,0,0" TextWrapping="Wrap" VerticalAlignment="Stretch" Foreground="#FFF70000" Text="{Binding ErrorMessage}" Style="{DynamicResource TextBlock}"/>
    </Grid>
</UserControl>
