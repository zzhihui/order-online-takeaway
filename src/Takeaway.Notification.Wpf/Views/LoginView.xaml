<UserControl
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:extension="clr-namespace:Takeaway.Admin.Wpf.Utility.Extension"
             xmlns:controls="http://metro.mahapps.com/winfx/xaml/controls"
             xmlns:local="clr-namespace:Takeaway.Admin.Wpf.Views"
             xmlns:xctk="http://schemas.xceed.com/wpf/xaml/toolkit"
             xmlns:i="http://schemas.microsoft.com/expression/2010/interactivity"
             xmlns:cal="http://www.caliburnproject.org"
             x:Class="Takeaway.Admin.Wpf.Views.LoginView"
             mc:Ignorable="d" 
             Height="300" Width="300"
             d:DesignHeight="300" d:DesignWidth="300">
    <xctk:BusyIndicator IsBusy="{Binding IsBusy}" BusyContent="Please Wait...." >
        <Grid>

            <Grid.RowDefinitions>

                <RowDefinition Height="Auto" />
                <RowDefinition Height="10" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="100*" />
            </Grid.RowDefinitions>
            <PasswordBox HorizontalAlignment="Stretch"  VerticalAlignment="Bottom"  Style="{DynamicResource PasswordBox}"
			        controls:TextBoxHelper.Watermark="Please enter your pin"
                    Grid.Row="0"
			        MaxLength="20"
			        extension:PasswordBoxAssistant.BindPassword="True"
			        extension:PasswordBoxAssistant.BoundPassword="{Binding Path=UserPin, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" TabIndex="1">
                <i:Interaction.Triggers>
                    <i:EventTrigger EventName="KeyDown">
                        <cal:ActionMessage MethodName="ExecuteFilterView">
                            <cal:Parameter Value="$executionContext"/>
                        </cal:ActionMessage>
                    </i:EventTrigger>
                </i:Interaction.Triggers>

            </PasswordBox>
            <Button x:Name="BtLogin" Content="Login" HorizontalAlignment="Right"  VerticalAlignment="Top" Width="100"  Grid.Row="2" TabIndex="2" Style="{DynamicResource YellowMediumButton}"/>
            <Button x:Name="BtShowSoftKey" Content="Show Virtual Keyboard" HorizontalAlignment="Left"  VerticalAlignment="Top" Width="150"  Grid.Row="3" TabIndex="3" Style="{DynamicResource YellowMediumButton}"/>
            <local:_ErrorMessage Grid.Row="4"/>

        </Grid>
    </xctk:BusyIndicator>
</UserControl>
