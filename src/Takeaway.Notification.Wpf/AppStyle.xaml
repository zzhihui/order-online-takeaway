<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    
    <!--Button-->
    <Style x:Key="CategoryMainButton" TargetType="Button">
        <Setter Property="Width" Value="120" />
        <Setter Property="Height" Value="60" />
        <Setter Property="Background" Value="#00A200" />
        <Setter Property="Foreground" Value="White" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Margin" Value="0,0,2,0" />
      
    </Style>
    <Style x:Key="CategorySubButton" TargetType="Button">
        <Setter Property="Width" Value="120" />
        <Setter Property="Height" Value="60" />
        <Setter Property="Background" Value="#5DBAD4" />
        <Setter Property="Foreground" Value="White" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Margin" Value="0,0,2,0" />
    </Style>

    <Style x:Key="MenuItemButton" TargetType="Button">

        <Setter Property="Background" Value="#FFD200" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Width" Value="150" />
        <Setter Property="Height" Value="120" />
        <Setter Property="Margin" Value="0,0,2,0" />
    </Style>


    <Style x:Key="YellowMediumButton" TargetType="Button">
        <Setter Property="Background" Value="#FFD200" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="Height" Value="60" />
    </Style>

    <Style x:Key="YellowBigButton" TargetType="Button">
        <Setter Property="Background" Value="#FFD200" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="Foreground" Value="Black" />
        <Setter Property="Width" Value="200" />
    </Style>

    <Style x:Key="YellowButton" TargetType="Button">
        <Setter Property="Background" Value="#FFD200" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="Foreground" Value="Black" />

    </Style>

    <!--TextBlock-->
    <Style x:Key="CategoryMainText" TargetType="TextBlock">
        <Setter Property="Width" Value="120" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="TextAlignment" Value="Center" />
    </Style>

    <Style x:Key="PriceStyleText" TargetType="TextBlock">
        <Setter Property="FontSize" Value="11" />
    </Style>



    <Style x:Key="SlashScreenText" TargetType="TextBlock">
        <Setter Property="TextAlignment" Value="Center" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="FontSize" Value="25" />
        <Setter Property="Foreground" Value="White" />
    </Style>

    <!--PasswordBox-->
    <Style x:Key="PasswordBox" TargetType="PasswordBox">
        <Setter Property="Height" Value="60" />
    </Style>

    <!--Lables-->
    <Style x:Key="WhiteLabel" TargetType="Label">
        <Setter Property="Foreground" Value="White" />
        <Setter Property="FontWeight" Value="Bold" />
    </Style>

    <Style x:Key="WhiteLargeLabel" TargetType="Label">
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="FontSize" Value="18" />
        <Setter Property="Foreground" Value="White" />
    </Style>

    <!--Scrollbar-->
    <Style TargetType="ScrollBar">
        <Style.Triggers>
            <Trigger Property="Orientation" Value="Vertical">
                <Setter Property="Width" Value="30"/>
                <Setter Property="Opacity" Value="0.5"/>
            </Trigger>
        </Style.Triggers>
    </Style>
    
   


</ResourceDictionary>